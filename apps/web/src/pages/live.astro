---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { marked } from 'marked';

// Read gigs markdown file directly
const gigsPath = join(process.cwd(), '../../packages/content/gigs/gigs.md');
const gigsText = await readFile(gigsPath, 'utf-8');
// Remove frontmatter
const gigsBody = gigsText.replace(/^---[\s\S]*?---\n/, '');
const gigRegex = /## (\d{4}-\d{2}-\d{2}) – (.+)/g;
const gigs: Array<{ date: string; venue: string; content: string; imageHtml: string | null; bodyHtml: string }> = [];

let match;
let lastIndex = 0;
const matches: Array<{ date: string; venue: string; index: number }> = [];

while ((match = gigRegex.exec(gigsBody)) !== null) {
  matches.push({
    date: match[1],
    venue: match[2],
    index: match.index,
  });
}

function parseGigContent(content: string): { imageHtml: string | null; bodyHtml: string } {
  const imgMatch = content.match(/^(<img[^>]*\/?>)\s*/i);
  if (!imgMatch) return { imageHtml: null, bodyHtml: content };
  const bodyHtml = content.slice(imgMatch[0].length).trim();
  return { imageHtml: imgMatch[1], bodyHtml };
}

matches.forEach((match, i) => {
  const nextMatch = matches[i + 1];
  const endIndex = nextMatch ? nextMatch.index : gigsBody.length;
  const content = gigsBody.substring(match.index, endIndex).replace(/## \d{4}-\d{2}-\d{2} – .+\n/, '').trim();
  const { imageHtml, bodyHtml } = parseGigContent(content);
  gigs.push({
    date: match.date,
    venue: match.venue,
    content,
    imageHtml,
    bodyHtml,
  });
});

// Build-time categorization serves as SSG fallback; client-side JS re-categorizes at runtime
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Stockholm' });
const upcoming = gigs.filter((g) => g.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = gigs.filter((g) => g.date < today).sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Live – Flykten"
  description="Kommande och tidigare spelningar med Flykten. Datum, platser och biljetter."
>
  <h1 class="page-title">Live</h1>

  <section id="upcoming-section">
    <h2>Kommande spelningar</h2>
    <p class="empty-message" style={upcoming.length > 0 ? 'display:none' : ''}>Inga kommande spelningar just nu. Håll utkik.</p>
    <div class="gigs" id="upcoming-gigs">
      {upcoming.map((gig) => (
        <article class={`gig section-card ${gig.imageHtml ? 'gig-with-image' : ''}`} data-gig-date={gig.date}>
          <h3>{gig.date} – {gig.venue}</h3>
          {gig.imageHtml ? (
            <div class="gig-grid">
              <div class="gig-poster" set:html={gig.imageHtml} />
              <div class="gig-body" set:html={marked.parse(gig.bodyHtml) as string} />
            </div>
          ) : (
            <div class="gig-body" set:html={marked.parse(gig.content) as string} />
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="past-section">
    <h2>Tidigare spelningar</h2>
    <p class="empty-message" style={past.length > 0 ? 'display:none' : ''}>Inga tidigare spelningar ännu.</p>
    <div class="gigs" id="past-gigs">
      {past.map((gig) => (
        <article class={`gig section-card ${gig.imageHtml ? 'gig-with-image' : ''}`} data-gig-date={gig.date}>
          <h3>{gig.date} – {gig.venue}</h3>
          {gig.imageHtml ? (
            <div class="gig-grid">
              <div class="gig-poster" set:html={gig.imageHtml} />
              <div class="gig-body" set:html={marked.parse(gig.bodyHtml) as string} />
            </div>
          ) : (
            <div class="gig-body" set:html={marked.parse(gig.content) as string} />
          )}
        </article>
      ))}
    </div>
  </section>

  <script>
    (function() {
      const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Stockholm' });
      const upcomingContainer = document.getElementById('upcoming-gigs');
      const pastContainer = document.getElementById('past-gigs');
      const upcomingSection = document.getElementById('upcoming-section');
      const pastSection = document.getElementById('past-section');
      if (!upcomingContainer || !pastContainer || !upcomingSection || !pastSection) return;

      const allGigs = [...document.querySelectorAll('[data-gig-date]')];
      const upcoming: Element[] = [];
      const past: Element[] = [];

      allGigs.forEach(gig => {
        const date = gig.getAttribute('data-gig-date') || '';
        if (date >= today) {
          upcoming.push(gig);
        } else {
          past.push(gig);
        }
      });

      upcoming.sort((a, b) => (a.getAttribute('data-gig-date') || '').localeCompare(b.getAttribute('data-gig-date') || ''));
      past.sort((a, b) => (b.getAttribute('data-gig-date') || '').localeCompare(a.getAttribute('data-gig-date') || ''));

      upcomingContainer.innerHTML = '';
      pastContainer.innerHTML = '';

      upcoming.forEach(gig => upcomingContainer.appendChild(gig));
      past.forEach(gig => pastContainer.appendChild(gig));

      const upcomingEmpty = upcomingSection.querySelector('.empty-message') as HTMLElement | null;
      const pastEmpty = pastSection.querySelector('.empty-message') as HTMLElement | null;
      if (upcomingEmpty) upcomingEmpty.style.display = upcoming.length === 0 ? '' : 'none';
      if (pastEmpty) pastEmpty.style.display = past.length === 0 ? '' : 'none';
    })();
  </script>

  <style>
    section {
      margin-bottom: var(--space-xl);
    }

    section h2 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--text-muted);
      margin-bottom: var(--space-md);
    }

    .gigs {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    .gig h3 {
      margin-top: 0;
      font-family: var(--font-mono);
      font-size: 1rem;
    }

    .gig-grid {
      display: grid;
      grid-template-columns: minmax(0, 280px) 1fr;
      gap: var(--space-lg);
      align-items: start;
    }

    .gig-poster :global(img) {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 2px;
    }

    @media (max-width: 600px) {
      .gig-grid {
        grid-template-columns: 1fr;
      }
    }

    .empty-message {
      color: var(--text-muted);
    }
  </style>
</BaseLayout>
