---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { marked } from 'marked';

const pressEntries = await getCollection('press');
const pressRelease = pressEntries.find(e => e.id === 'pressmeddelande.md');
const bioShort = pressEntries.find(e => e.id === 'bio.short.md');
const bioMedium = pressEntries.find(e => e.id === 'bio.medium.md');
const bioLong = pressEntries.find(e => e.id === 'bio.long.md');

const releaseRendered = pressRelease ? await pressRelease.render() : null;
const shortRendered = bioShort ? await bioShort.render() : null;
const mediumRendered = bioMedium ? await bioMedium.render() : null;
const longRendered = bioLong ? await bioLong.render() : null;
const PressRelease = releaseRendered?.Content;
const ShortBio = shortRendered?.Content;
const MediumBio = mediumRendered?.Content;
const LongBio = longRendered?.Content;

const pressPhoto = {
  src: '/images/press/flykten-press-2026.jpg',
  alt: 'Pressbild på Flykten: fyra bandmedlemmar poserar mot en ljus putsad vägg. En av dem bär en keps med bandnamnet.',
  caption: 'Flykten. Pressbild.',
  filename: 'flykten-press-2026.jpg',
};

const contactPath = join(process.cwd(), '../../packages/content/contact.md');
const contactText = await readFile(contactPath, 'utf-8');
const frontmatterMatch = contactText.match(/^---\n([\s\S]*?)\n---/);
let email = 'contact@flykten.se';
if (frontmatterMatch) {
  const emailMatch = frontmatterMatch[1].match(/email:\s*(.+)/);
  if (emailMatch) email = emailMatch[1].trim();
}
const contactBodyRaw = contactText.replace(/^---[\s\S]*?---\n/, '').trim();
const contactBody = marked.parse(contactBodyRaw) as string;
---

<BaseLayout
  title="Press – Flykten"
  description="Press och media – pressmeddelande, bio, pressbilder och kontakt till Flykten för intervjuer och samarbeten."
  image={pressPhoto.src}
>
  <h1 class="page-title">Press</h1>

  {PressRelease && pressRelease && (
    <section aria-labelledby="press-release-heading">
      <h2 id="press-release-heading">Pressmeddelande</h2>
      <article class="bio section-card">
        <h3>{pressRelease.data.title}</h3>
        <div class="bio-content">
          <PressRelease />
        </div>
      </article>
    </section>
  )}

  <section aria-labelledby="bio-heading">
    <h2 id="bio-heading">Bio</h2>

    {ShortBio && bioShort && (
      <article class="bio section-card">
        <h3>{bioShort.data.title}</h3>
        <div class="bio-content">
          <ShortBio />
        </div>
      </article>
    )}

    {MediumBio && bioMedium && (
      <article class="bio section-card">
        <h3>{bioMedium.data.title}</h3>
        <div class="bio-content">
          <MediumBio />
        </div>
      </article>
    )}

    {LongBio && bioLong && (
      <article class="bio section-card">
        <h3>{bioLong.data.title}</h3>
        <div class="bio-content">
          <LongBio />
        </div>
      </article>
    )}
  </section>

  <section aria-labelledby="press-photos-heading">
    <h2 id="press-photos-heading">Pressbilder</h2>
    <figure class="press-photo">
      <img
        src={pressPhoto.src}
        alt={pressPhoto.alt}
        width="1024"
        height="1024"
      />
      <figcaption>
        {pressPhoto.caption}
        {' '}
        <a href={pressPhoto.src} download={pressPhoto.filename}>Ladda ner JPG</a>
      </figcaption>
    </figure>
    <p>Behöver du mer material, mejla <a href={`mailto:${email}`}>{email}</a>.</p>
  </section>

  <section aria-labelledby="press-contact-heading">
    <h2 id="press-contact-heading">Kontakt</h2>
    <div class="contact-content" set:html={contactBody} />
  </section>

  <style>
    section {
      margin-bottom: var(--space-xl);
      border-bottom: 1px solid var(--border);
      padding-bottom: var(--space-lg);
    }

    section:last-child {
      border-bottom: none;
    }

    section h2 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--text-muted);
      margin-bottom: var(--space-md);
    }

    .bio {
      margin-bottom: var(--space-md);
    }

    .bio h3 {
      margin-top: 0;
    }

    .bio-content,
    .contact-content {
      line-height: 1.6;
    }

    .bio-content :global(p) {
      margin: 0 0 var(--space-sm) 0;
    }

    .bio-content :global(blockquote),
    .bio-content :global(ul) {
      margin: 0 0 var(--space-sm) 0;
    }

    .contact-content :global(a),
    .press-photo a {
      color: var(--accent);
    }

    .press-photo {
      margin: 0 0 var(--space-md) 0;
      max-width: 32rem;
    }

    .press-photo img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
    }

    .press-photo figcaption {
      margin-top: var(--space-sm);
      color: var(--text-muted);
      font-size: 0.95rem;
    }
  </style>
</BaseLayout>
